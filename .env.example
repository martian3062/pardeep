# Copy to .env and fill in what you need. .env is gitignored.
# Nothing here is required to run the local-only paths (ingest, memory, vision):
# a missing key disables the feature that needs it, it does not crash the tool.

# ─── Cloud reply backends (src/twin/router.py) ────────────────────────────────
# Used only when no local twin is served by Ollama, and they only ever see the
# persona card plus the snippets retrieval already chose — never the archives.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_ORG_ID=          # optional, only if your account requires it

# ─── Identity / dataset extraction (src/dataset/) ─────────────────────────────
# Same client as above; listed separately because these are batch jobs that
# sample the corpus rather than serve a turn.

# ─── Voice ────────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=     # voice cloning + TTS. The one path that uploads audio.
CARTESIA_API_KEY=       # optional alternative TTS, not wired up
SARVAM_API_KEY=         # optional Indic ASR/TTS, not wired up
GROQ_API_KEY=           # optional fast Whisper, not wired up

# ─── Models that need a gated download (src/ingest/diarize.py) ────────────────
# Accept the terms on huggingface.co for BOTH pyannote/speaker-diarization-3.1
# and pyannote/segmentation-3.0, then paste the token here.
HF_TOKEN=
PYANNOTE_CACHE=         # optional override; defaults under ME_TOO_CACHE_ROOT

# ─── Remote training (scripts/train_remote.ps1, training/kaggle_run.py) ───────
TRAIN_VM=               # user@host of the rented GPU box
TRAIN_VM_KEY=           # path to the ssh private key for it
KAGGLE_USERNAME=        # free T4 fallback, 30 GPU-h/week
KAGGLE_API_TOKEN=
KAGGLE_USERNAME_ALT=    # second account, for another 30 GPU-h/week
KAGGLE_API_TOKEN_ALT=

# ─── Local paths ──────────────────────────────────────────────────────────────
# Every model cache, venv and GGUF lives outside the repo so the 30GB of data
# and the caches never end up in git or on the system drive.
ME_TOO_CACHE_ROOT=E:\cache
